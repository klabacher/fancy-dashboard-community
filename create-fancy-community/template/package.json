{
  "name": "@fancydashboard/pack-module-{{pluginName}}",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    }
  },
  "dependencies": {
    "@fancydashboard/sdk": "workspace:*",
    "react": "^19.1.0",
    "lucide-react": "^0.561.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@fancydashboard/runtime": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/manifest.ts --format esm,cjs --dts --clean",
    "dev": "TSUP_OUT_DIR=\"$APPDATA/com.klabacher.fancydashboard/plugins/{{pluginName}}\" tsup src/index.ts src/manifest.ts --format esm,cjs --watch"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
